{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mu-asset-lab.local/schemas/run.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "asset_id", "version", "stage", "status", "started_at", "goal", "actor", "environment", "parameters", "inputs", "steps", "outputs", "observations", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "asset_id": {"type": "string"},
    "version": {"type": "string"},
    "stage": {"type": "string"},
    "status": {"enum": ["planned", "running", "completed", "failed", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"]},
    "goal": {"type": "string"},
    "actor": {"type": "string"},
    "environment": {"type": "object"},
    "parameters": {"type": "object"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "observations": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "result"], "properties": {
      "name": {"type": "string"}, "result": {"enum": ["pass", "fail", "manual", "unknown"]},
      "evidence": {"type": "string"}
    }, "additionalProperties": false}},
    "lessons": {"type": "array", "items": {"type": "string"}}
  }
}
